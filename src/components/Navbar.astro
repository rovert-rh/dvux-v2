---
const navLinks = [
  { href: "/#inicio", label: "Inicio" },
  { href: "/#servicios", label: "Servicios" },
  { href: "/#portafolio", label: "Portafolio" },
  { href: "/#proceso", label: "Proceso" },
  { href: "/catalogo", label: "Catalogo" },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  id="navbar"
>
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16 lg:h-20">
    <!-- Logo -->
    <a href="/" class="flex-shrink-0">
      <img class="h-8 lg:h-10 w-auto" src="/logo.webp" alt="DVUX" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-[#A1A1AA] text-sm font-medium hover:text-[#F4F4F5] transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-[#41B6A1] after:transition-all hover:after:w-full"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <a
      href="#contacto"
      class="hidden lg:inline-flex items-center gap-2 bg-[#41B6A1] text-[#0a0b10] text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-[#34927b] transition-colors btn-glow"
    >
      Contacto
    </a>

    <!-- Mobile hamburger -->
    <button
      class="lg:hidden flex flex-col gap-1.5 p-2"
      id="mobile-menu-icon"
      aria-label="Abrir menu"
    >
      <span class="block w-6 h-0.5 bg-[#41B6A1] transition-all origin-center" id="bar1"></span>
      <span class="block w-6 h-0.5 bg-[#41B6A1] transition-all" id="bar2"></span>
      <span class="block w-6 h-0.5 bg-[#41B6A1] transition-all origin-center" id="bar3"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    class="lg:hidden fixed inset-0 bg-[#0a0b10]/95 backdrop-blur-xl z-40 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300"
    id="mobile-menu"
  >
    <button
      class="absolute top-5 right-6 text-[#A1A1AA] hover:text-white p-2"
      id="mobile-menu-close"
      aria-label="Cerrar menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-link text-[#F4F4F5] text-2xl font-semibold hover:text-[#41B6A1] transition-colors"
      >
        {link.label}
      </a>
    ))}

    <a
      href="#contacto"
      class="mobile-link mt-4 bg-[#41B6A1] text-[#0a0b10] font-semibold px-8 py-3 rounded-lg text-lg hover:bg-[#34927b] transition-colors"
    >
      Contacto
    </a>
  </div>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const menuIcon = document.getElementById("mobile-menu-icon");
  const menuClose = document.getElementById("mobile-menu-close");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  // Scroll effect - add glass bg on scroll
  window.addEventListener("scroll", () => {
    if (navbar) {
      if (window.scrollY > 50) {
        navbar.classList.add("bg-[#0a0b10]/80", "backdrop-blur-xl", "border-b", "border-white/[0.06]");
      } else {
        navbar.classList.remove("bg-[#0a0b10]/80", "backdrop-blur-xl", "border-b", "border-white/[0.06]");
      }
    }
  });

  function openMenu() {
    if (mobileMenu) {
      mobileMenu.classList.remove("opacity-0", "pointer-events-none");
      mobileMenu.classList.add("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "hidden";
    }
  }

  function closeMenu() {
    if (mobileMenu) {
      mobileMenu.classList.add("opacity-0", "pointer-events-none");
      mobileMenu.classList.remove("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "";
    }
  }

  menuIcon?.addEventListener("click", openMenu);
  menuClose?.addEventListener("click", closeMenu);
  mobileLinks.forEach((link) => link.addEventListener("click", closeMenu));
</script>
