---
interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section id={id} class="relative py-24 md:py-32 overflow-hidden">
  <div class="glow-teal" style="top: -100px; left: 50%; transform: translateX(-50%); opacity: 0.25;"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-6">
    <div class="text-center mb-12 reveal">
      <span class="text-[#41B6A1] text-sm font-semibold tracking-wider uppercase mb-4 block">
        Contacto
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6">
        Agenda tu <span class="text-[#41B6A1]">llamada gratis</span>
      </h2>
      <p class="text-[#A1A1AA] text-lg max-w-xl mx-auto">
        15 minutos para entender tu negocio y mostrarte como seria tu landing. Sin compromiso.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">
      <!-- Info side -->
      <div class="lg:col-span-2 space-y-6 reveal" style="transition-delay: 100ms;">
        <div class="glass-card p-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-[#41B6A1]/10 flex items-center justify-center text-[#41B6A1] flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <h3 class="text-[#F4F4F5] font-semibold text-sm mb-1">Telefono</h3>
              <p class="text-[#71717A] text-sm">+593 984850656</p>
            </div>
          </div>
        </div>

        <div class="glass-card p-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-[#41B6A1]/10 flex items-center justify-center text-[#41B6A1] flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <h3 class="text-[#F4F4F5] font-semibold text-sm mb-1">Email</h3>
              <p class="text-[#71717A] text-sm">dvuxlat@gmail.com</p>
            </div>
          </div>
        </div>

        <div class="glass-card p-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-[#41B6A1]/10 flex items-center justify-center text-[#41B6A1] flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <h3 class="text-[#F4F4F5] font-semibold text-sm mb-1">Respuesta</h3>
              <p class="text-[#71717A] text-sm">En menos de 24 horas</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Calendly -->
      <div class="lg:col-span-3 glass-card overflow-hidden reveal" style="transition-delay: 200ms;">
        <div
          class="calendly-inline-widget"
          data-url="https://calendly.com/dvuxlat/idea"
          style="min-width: 100%; height: 580px;"
        >
        </div>
      </div>
    </div>
  </div>

  <script
    type="text/javascript"
    src="https://assets.calendly.com/assets/external/widget.js"
    async></script>
</section>
