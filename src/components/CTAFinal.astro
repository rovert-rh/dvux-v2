---
interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section id={id} class="relative py-24 md:py-32 overflow-hidden">
  <div class="glow-teal" style="top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.3;"></div>

  <div class="relative z-10 max-w-3xl mx-auto px-6 text-center reveal">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6 leading-tight">
      Tu competencia ya tiene web.
      <br />
      <span class="text-[#EE738F]">Y tu?</span>
    </h2>

    <p class="text-[#A1A1AA] text-lg md:text-xl max-w-xl mx-auto mb-10 leading-relaxed">
      Agenda una llamada gratis de 15 minutos y te mostramos
      como seria tu landing. Sin compromiso.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="#contacto"
        class="btn-glow inline-flex items-center gap-2 bg-[#41B6A1] text-[#0a0b10] font-semibold px-8 py-4 rounded-lg text-base hover:bg-[#34927b] transition-colors"
      >
        Agendar llamada ahora
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <p class="text-[#52525B] text-sm mt-6">
      Respuesta en menos de 24 horas. Prometido.
    </p>
  </div>

  <div class="gradient-line max-w-3xl mx-auto mt-24"></div>
</section>
