---
interface Props {
  id?: string;
}

const { id } = Astro.props;

const projects = [
  {
    image: "/project1.webp",
    name: "SIMAO",
    clientType: "Startup tech",
    category: "Diseno + Desarrollo",
    description: "Landing page completa con sistema de captacion de leads y diseno orientado a conversion.",
  },
  {
    image: "/project3.webp",
    name: "SOC Hidra",
    clientType: "Ciberseguridad",
    category: "Diseno + Desarrollo",
    description: "Sitio corporativo profesional que transmite confianza y autoridad en el sector.",
  },
  {
    image: "/project4.webp",
    name: "Bosterst",
    clientType: "Marca digital",
    category: "Diseno + Desarrollo",
    description: "Landing de producto con copy persuasivo y animaciones que aumentan el engagement.",
  },
  {
    image: "/project9.webp",
    name: "Eduland",
    clientType: "Educacion online",
    category: "UX/UI + Desarrollo",
    description: "Plataforma educativa con experiencia de usuario optimizada para estudiantes.",
  },
  {
    image: "/project8.webp",
    name: "Ezencial",
    clientType: "Marca de bienestar",
    category: "Desarrollo web",
    description: "E-commerce minimalista enfocado en la experiencia de compra y conversion.",
  },
  {
    image: "/project10.webp",
    name: "Abogados Guerrero",
    clientType: "Despacho legal",
    category: "Diseno + Branding",
    description: "Identidad visual completa y landing profesional para captar clientes locales.",
  },
];
---

<section id={id} class="relative py-24 md:py-32 overflow-hidden">
  <div class="glow-pink" style="top: -100px; right: -200px; opacity: 0.3;"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="text-[#41B6A1] text-sm font-semibold tracking-wider uppercase mb-4 block">
        Portafolio
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6">
        Proyectos que <span class="text-[#41B6A1]">generan resultados</span>
      </h2>
      <p class="text-[#A1A1AA] text-lg max-w-2xl mx-auto">
        Cada proyecto esta disenado con un objetivo claro: ayudar a nuestros clientes a crecer.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, i) => (
        <div
          class="group glass-card overflow-hidden reveal"
          style={`transition-delay: ${i * 100}ms;`}
        >
          <!-- Image -->
          <div class="relative h-48 overflow-hidden">
            <img
              src={project.image}
              alt={project.name}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0b10] via-transparent to-transparent"></div>
            <!-- Category badge -->
            <div class="absolute top-3 left-3">
              <span class="bg-[#EE738F]/15 text-[#EE738F] text-xs font-medium px-3 py-1 rounded-md backdrop-blur-sm border border-[#EE738F]/10">
                {project.category}
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-[#F4F4F5] font-bold text-lg">{project.name}</h3>
              <span class="text-[#52525B] text-xs">{project.clientType}</span>
            </div>
            <p class="text-[#71717A] text-sm leading-relaxed mb-4">
              {project.description}
            </p>
            <div class="flex items-center gap-2 text-[#41B6A1] text-sm font-medium group/link cursor-pointer">
              <span>Ver proyecto</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover/link:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
