---
interface Props {
  id?: string;
}

const { id } = Astro.props;

const features = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
    title: "Diseno personalizado",
    description: "No es plantilla. Cada landing se disena desde cero para tu marca y audiencia.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    title: "Copy persuasivo incluido",
    description: "Textos escritos para convencer a tu cliente ideal. No solo 'lorem ipsum'.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title: "Optimizada para movil",
    description: "Responsive perfecto. El 70% de tus clientes te veran desde el celular.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    title: "SEO basico configurado",
    description: "Tu landing aparecera en Google cuando busquen tus servicios.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: "Entrega en 7 dias",
    description: "Sin meses de espera. En una semana tu landing esta online y trabajando.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>`,
    title: "2 rondas de revision",
    description: "Ajustamos hasta que quede perfecto. Tu feedback es parte del proceso.",
  },
];
---

<section id={id} class="relative py-24 md:py-32 overflow-hidden">
  <!-- Gradient mesh -->
  <div class="glow-teal" style="top: 50%; left: -200px; opacity: 0.5;"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="text-[#41B6A1] text-sm font-semibold tracking-wider uppercase mb-4 block">
        La solucion
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6">
        Una landing que trabaja
        <span class="text-[#41B6A1]">por ti 24/7</span>
      </h2>
      <p class="text-[#A1A1AA] text-lg max-w-2xl mx-auto">
        No es solo diseno bonito. Es una pagina construida para que tus clientes
        ideales te encuentren, confien y te contacten.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((feature, i) => (
        <div
          class="glass-card p-6 reveal"
          style={`transition-delay: ${i * 80}ms;`}
        >
          <div class="w-10 h-10 rounded-lg bg-[#41B6A1]/10 flex items-center justify-center text-[#41B6A1] mb-4">
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="text-[#F4F4F5] font-semibold text-lg mb-2">
            {feature.title}
          </h3>
          <p class="text-[#71717A] text-sm leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>

  <div class="gradient-line max-w-3xl mx-auto mt-24"></div>
</section>
