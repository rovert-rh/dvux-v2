---
interface Props {
  id?: string;
}

const { id } = Astro.props;

const testimonials = [
  {
    quote: "Nos entregaron la landing en menos de una semana. El diseño quedó exactamente como lo necesitábamos y ya estamos recibiendo contactos.",
    name: "Carlos M.",
    role: "Consultor de negocios",
    avatar: null,
  },
  {
    quote: "Yo intenté hacer mi página por meses y nunca la terminaba. DVUX me la entregó lista, profesional y optimizada. Mejor inversión que he hecho.",
    name: "Andrea R.",
    role: "Fotógrafa freelance",
    avatar: null,
  },
  {
    quote: "Lo que más me gustó es que no solo diseñaron bonito, sino que pensaron en cómo convertir visitantes en clientes. Se nota la diferencia.",
    name: "Miguel T.",
    role: "Coach de desarrollo personal",
    avatar: null,
  },
];
---

<section id={id} class="relative py-24 md:py-32 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="text-[#41B6A1] text-sm font-semibold tracking-wider uppercase mb-4 block">
        Testimonios
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6">
        Lo que dicen <span class="text-[#41B6A1]">nuestros clientes</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((testimonial, i) => (
        <div
          class="glass-card p-6 flex flex-col reveal"
          style={`transition-delay: ${i * 120}ms;`}
        >
          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {Array.from({ length: 5 }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#41B6A1" stroke="none">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <p class="text-[#A1A1AA] text-sm leading-relaxed flex-grow mb-6">
            "{testimonial.quote}"
          </p>

          <!-- Author -->
          <div class="flex items-center gap-3 pt-4 border-t border-white/[0.06]">
            <div class="w-10 h-10 rounded-full bg-[#41B6A1]/15 flex items-center justify-center text-[#41B6A1] font-bold text-sm">
              {testimonial.name.charAt(0)}
            </div>
            <div>
              <p class="text-[#F4F4F5] font-medium text-sm">{testimonial.name}</p>
              <p class="text-[#52525B] text-xs">{testimonial.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Logos section -->
    <div class="mt-20 reveal" style="transition-delay: 400ms;">
      <p class="text-center text-[#52525B] text-sm mb-8 uppercase tracking-wider">
        Marcas que confían en nosotros
      </p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12 opacity-50 hover:opacity-70 transition-opacity">
        <img src="/simao.webp" alt="SIMAO" class="h-8 md:h-10 w-auto object-contain grayscale" loading="lazy" />
        <img src="/HYDRA.webp" alt="Hydra" class="h-8 md:h-10 w-auto object-contain grayscale" loading="lazy" />
        <img src="/Boster.webp" alt="Bosterst" class="h-8 md:h-10 w-auto object-contain grayscale" loading="lazy" />
        <img src="/EZENCIAL.webp" alt="Ezencial" class="h-8 md:h-10 w-auto object-contain grayscale" loading="lazy" />
      </div>
    </div>
  </div>

  <div class="gradient-line max-w-3xl mx-auto mt-24"></div>
</section>
