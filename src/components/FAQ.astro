---
interface Props {
  id?: string;
}

const { id } = Astro.props;

const faqs = [
  {
    question: "Que necesito para empezar?",
    answer: "Solo una llamada de 15 minutos. Ahi entendemos tu negocio, tu audiencia y que quieres lograr. Nosotros nos encargamos del resto.",
  },
  {
    question: "Puedo ver un avance antes de pagar todo?",
    answer: "Si. Trabajamos con un anticipo del 50% para iniciar. Te mostramos el diseno antes de desarrollar, y solo avanzamos cuando apruebes.",
  },
  {
    question: "Que pasa si no me gusta el diseno?",
    answer: "Para eso estan las rondas de revision. Ajustamos colores, estructura, textos... lo que necesites hasta que quede como lo imaginas.",
  },
  {
    question: "Incluye hosting y dominio?",
    answer: "El diseno y desarrollo estan incluidos. Hosting y dominio son servicios externos que te ayudamos a configurar (muchos son gratuitos).",
  },
  {
    question: "Puedo modificar la landing despues?",
    answer: "Si. Tu landing es tuya. Te entregamos el codigo completo y puedes editarlo cuando quieras. Si necesitas ayuda, estamos disponibles.",
  },
  {
    question: "En cuanto tiempo empiezo a ver resultados?",
    answer: "Desde el dia 1 que tu landing este online. Pero los mejores resultados vienen cuando la combinas con una estrategia de contenido o ads.",
  },
];
---

<section id={id} class="relative py-24 md:py-32 overflow-hidden">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="text-[#41B6A1] text-sm font-semibold tracking-wider uppercase mb-4 block">
        Preguntas frecuentes
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6">
        Resolvemos tus <span class="text-[#41B6A1]">dudas</span>
      </h2>
    </div>

    <div class="space-y-3">
      {faqs.map((faq, i) => (
        <div
          class="glass-card overflow-hidden reveal"
          style={`transition-delay: ${i * 80}ms;`}
        >
          <button
            class="faq-toggle w-full flex items-center justify-between p-5 text-left cursor-pointer"
            aria-expanded="false"
          >
            <span class="text-[#F4F4F5] font-medium text-base pr-4">{faq.question}</span>
            <svg
              class="faq-icon flex-shrink-0 w-5 h-5 text-[#41B6A1] transition-transform duration-300"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="12" y1="5" x2="12" y2="19" />
              <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
          </button>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300">
            <p class="px-5 pb-5 text-[#A1A1AA] text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll(".faq-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const content = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector(".faq-icon") as HTMLElement;
      const expanded = btn.getAttribute("aria-expanded") === "true";

      // Close all others
      document.querySelectorAll(".faq-toggle").forEach((other) => {
        if (other !== btn) {
          other.setAttribute("aria-expanded", "false");
          const otherContent = other.nextElementSibling as HTMLElement;
          const otherIcon = other.querySelector(".faq-icon") as HTMLElement;
          if (otherContent) otherContent.style.maxHeight = "0";
          if (otherIcon) otherIcon.style.transform = "rotate(0deg)";
        }
      });

      // Toggle current
      if (expanded) {
        btn.setAttribute("aria-expanded", "false");
        content.style.maxHeight = "0";
        icon.style.transform = "rotate(0deg)";
      } else {
        btn.setAttribute("aria-expanded", "true");
        content.style.maxHeight = content.scrollHeight + "px";
        icon.style.transform = "rotate(45deg)";
      }
    });
  });
</script>
