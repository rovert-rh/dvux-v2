---
interface Props {
  id?: string;
}

const { id } = Astro.props;

const steps = [
  {
    number: "01",
    title: "Agenda una llamada",
    description: "15 minutos para entender tu negocio, tu audiencia y tus objetivos.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: "02",
    title: "Recibe tu propuesta",
    description: "En 24 horas tienes el diseno y plan de tu landing para revisar.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  },
  {
    number: "03",
    title: "Revisamos juntos",
    description: "2 rondas de feedback para ajustar cada detalle hasta que quede perfecto.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>`,
  },
  {
    number: "04",
    title: "Lanza tu landing",
    description: "Tu pagina esta online, lista para recibir clientes y generar contactos.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>`,
  },
];
---

<section id={id} class="relative py-24 md:py-32 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="text-[#41B6A1] text-sm font-semibold tracking-wider uppercase mb-4 block">
        Como funciona
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6">
        4 pasos. <span class="text-[#41B6A1]">7 dias.</span> Tu landing online.
      </h2>
      <p class="text-[#A1A1AA] text-lg max-w-2xl mx-auto">
        Un proceso simple y transparente. Sin sorpresas, sin letra pequena.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step, i) => (
        <div
          class="relative glass-card p-6 text-center reveal"
          style={`transition-delay: ${i * 120}ms;`}
        >
          <!-- Step number -->
          <span class="text-[#41B6A1]/20 font-bold text-6xl absolute top-3 right-4 select-none">
            {step.number}
          </span>

          <!-- Icon -->
          <div class="w-14 h-14 rounded-xl bg-[#41B6A1]/10 flex items-center justify-center text-[#41B6A1] mx-auto mb-5">
            <Fragment set:html={step.icon} />
          </div>

          <!-- Content -->
          <h3 class="text-[#F4F4F5] font-semibold text-lg mb-3">
            {step.title}
          </h3>
          <p class="text-[#71717A] text-sm leading-relaxed">
            {step.description}
          </p>

          <!-- Connector line (not on last) -->
          {i < steps.length - 1 && (
            <div class="hidden lg:block absolute top-1/2 -right-3 w-6 h-px bg-gradient-to-r from-[#41B6A1]/30 to-transparent"></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
