---
interface Props {
  id?: string;
}

const { id } = Astro.props;

const stats = [
  { value: 10, suffix: "+", label: "Proyectos entregados" },
  { value: 7, suffix: " días", label: "Tiempo promedio de entrega" },
  { value: 100, suffix: "%", label: "Clientes satisfechos" },
  { value: 24, suffix: "h", label: "Tiempo de respuesta" },
];
---

<section id={id} class="relative py-16 md:py-20 overflow-hidden">
  <div class="gradient-line max-w-3xl mx-auto mb-16"></div>

  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map((stat, i) => (
        <div
          class="text-center reveal"
          style={`transition-delay: ${i * 100}ms;`}
        >
          <div class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#F4F4F5] mb-2">
            <span class="stat-number" data-target={stat.value}>0</span>
            <span class="text-[#41B6A1]">{stat.suffix}</span>
          </div>
          <p class="text-[#71717A] text-sm">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="gradient-line max-w-3xl mx-auto mt-16"></div>
</section>

<script>
  const counters = document.querySelectorAll(".stat-number");

  const animateCounter = (el: Element) => {
    const target = parseInt(el.getAttribute("data-target") || "0");
    const duration = 1500;
    const start = performance.now();

    const update = (now: number) => {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      // ease out cubic
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(target * eased).toString();
      if (progress < 1) requestAnimationFrame(update);
    };

    requestAnimationFrame(update);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.5 }
  );

  counters.forEach((counter) => observer.observe(counter));
</script>
