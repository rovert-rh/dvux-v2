---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import TemplatesSection from "../components/TemplatesSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Catálogo | DVUX - Plantillas para freelancers" description="Plantillas web profesionales listas para usar. Responsive, optimizadas para convertir y fáciles de personalizar. Desde $39.99 USD.">
  <main>
    <Navbar />

    <!-- Hero catalogo -->
    <section class="relative pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden bg-dot-pattern">
      <div class="glow-teal" style="top: -150px; left: -100px; opacity: 0.3;"></div>
      <div class="glow-pink" style="bottom: -100px; right: -150px; opacity: 0.2;"></div>

      <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
        <span class="text-[#41B6A1] text-sm font-semibold tracking-wider uppercase mb-4 block">
          Tienda DVUX
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6">
          Plantillas listas para
          <span class="text-[#41B6A1]">vender</span>
        </h1>
        <p class="text-[#A1A1AA] text-lg md:text-xl max-w-2xl mx-auto mb-8">
          Diseños profesionales, responsivos y optimizados para convertir.
          Elige, personaliza y lanza en menos de 24 horas.
        </p>

        <!-- Tech badges -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          <span class="text-xs bg-white/[0.04] border border-white/[0.08] text-[#A1A1AA] px-4 py-2 rounded-lg">
            Astro
          </span>
          <span class="text-xs bg-white/[0.04] border border-white/[0.08] text-[#A1A1AA] px-4 py-2 rounded-lg">
            React
          </span>
          <span class="text-xs bg-white/[0.04] border border-white/[0.08] text-[#A1A1AA] px-4 py-2 rounded-lg">
            Tailwind CSS
          </span>
          <span class="text-xs bg-white/[0.04] border border-white/[0.08] text-[#A1A1AA] px-4 py-2 rounded-lg">
            100% Responsive
          </span>
        </div>
      </div>

      <div class="gradient-line max-w-3xl mx-auto mt-16"></div>
    </section>

    <TemplatesSection />

    <!-- Upsell section -->
    <section class="relative py-16 md:py-24 overflow-hidden">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <div class="glass-card p-8 md:p-12">
          <h2 class="text-2xl md:text-3xl font-bold mb-4">
            ¿Necesitas algo <span class="text-[#41B6A1]">a tu medida</span>?
          </h2>
          <p class="text-[#A1A1AA] text-base mb-8 max-w-xl mx-auto">
            Podemos personalizar cualquier plantilla o crear tu landing desde cero.
            Diseño + copy + desarrollo en 7 días.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/#precios"
              class="btn-glow bg-[#41B6A1] text-[#0a0b10] font-semibold px-8 py-3.5 rounded-lg hover:bg-[#34927b] transition-colors"
            >
              Ver paquetes desde $150 USD
            </a>
            <a
              href="/#contacto"
              class="border border-white/10 text-[#F4F4F5] font-medium px-8 py-3.5 rounded-lg hover:border-[#41B6A1]/30 hover:bg-white/[0.02] transition-all"
            >
              Hablar con el equipo
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
