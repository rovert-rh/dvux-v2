---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Landings profesionales para freelancers y creativos. Diseño + copy + desarrollo en 7 días. DVUX." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, "https://dvuxlat.netlify.app");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo2.ico" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="google-site-verification"
      content="43qtsbKn2orCTlXVNQamxAcQn-CuuYsDYoxQVzExVuU"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content="https://dvuxlat.netlify.app/logo.webp" />
    <meta property="og:site_name" content="DVUX" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- Google tag (gtag.js) -->
    <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-90082RCYNH"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-90082RCYNH");
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: "Inter", system-ui, sans-serif;
    background: #0a0b10;
    color: #f4f4f5;
    scroll-behavior: smooth;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    letter-spacing: -0.02em;
  }

  body {
    margin: 0;
    overflow-x: hidden;
  }

  /* Dot grid background pattern */
  .bg-dot-pattern {
    background-image: radial-gradient(
      rgba(255, 255, 255, 0.04) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
  }

  /* Gradient mesh orbs */
  .glow-teal {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: rgba(65, 182, 161, 0.15);
    filter: blur(150px);
    pointer-events: none;
  }

  .glow-pink {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: rgba(238, 115, 143, 0.08);
    filter: blur(180px);
    pointer-events: none;
  }

  /* Gradient line separator */
  .gradient-line {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(65, 182, 161, 0.3),
      transparent
    );
  }

  /* Glow button effect */
  .btn-glow {
    box-shadow:
      0 0 20px rgba(65, 182, 161, 0.25),
      0 0 60px rgba(65, 182, 161, 0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-glow:hover {
    box-shadow:
      0 0 30px rgba(65, 182, 161, 0.4),
      0 0 80px rgba(65, 182, 161, 0.15);
    transform: translateY(-1px);
  }

  /* Glass card */
  .glass-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glass-card:hover {
    border-color: rgba(65, 182, 161, 0.25);
    box-shadow: 0 0 30px rgba(65, 182, 161, 0.08);
  }

  /* Scroll reveal animation */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
